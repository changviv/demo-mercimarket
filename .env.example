#############################################################################
# Merci Market catering — environment.
#
#   cp .env.example .env    then fill in the real values.
#
# .env is gitignored and MUST STAY THAT WAY. In production do not ship a .env
# file at all: inject these from your platform's secret manager (AWS Secrets
# Manager, Vercel/Render env vars, Doppler, 1Password Connect — whichever the
# client already uses).
#
# HOW THE SPLIT WORKS
#   Everything in this file is read ONLY by server/lib/tenants.js, in the Node
#   process. None of it is prefixed VITE_, so Vite will not — and cannot —
#   inline any of it into the browser bundle. `npm run audit:secrets` fails the
#   build if a secret-shaped string ever reaches dist/.
#
#   The one value the browser legitimately receives is
#   STRIPE_PUBLISHABLE_KEY_*, and it is served through GET /api/config/:id
#   rather than bundled, because the correct key depends on which of the six
#   stores the customer picked.
#
# ONE TOAST RESTAURANT AND ONE STRIPE ACCOUNT PER LOCATION
#   Six independent Stripe accounts (not Connect) — each store settles to its
#   own bank. Six Toast restaurant GUIDs. Suffixes below must match exactly:
#   GREENWICH_VILLAGE, UNION_SQUARE, CHELSEA, MURRAY_HILL, BRYANT_PARK,
#   CENTRAL_PARK.
#############################################################################

# ---- Server ---------------------------------------------------------------
PORT=8787
# Lock this to the real front-end origin in production. `true` allows any.
ALLOWED_ORIGIN=http://localhost:5173

# Bearer token protecting the staff-only capture endpoint. Generate with:
#   openssl rand -base64 32
# An unset value makes /api/orders/:id/capture return 503 rather than open.
STAFF_API_TOKEN=

# ---- Toast ----------------------------------------------------------------
# Sandbox:    https://ws-sandbox-api.eng.toasttab.com
# Production: https://ws-api.toasttab.com
TOAST_API_BASE=https://ws-sandbox-api.eng.toasttab.com

# One shared secret for the menus + stock webhook (per integration, not per
# restaurant). Toast signs the raw body HMAC-SHA256, base64.
TOAST_WEBHOOK_SECRET=

# --- Greenwich Village, 45 University Pl
TOAST_RESTAURANT_GUID_GREENWICH_VILLAGE=
TOAST_CLIENT_ID_GREENWICH_VILLAGE=
TOAST_CLIENT_SECRET_GREENWICH_VILLAGE=
TOAST_DINING_OPTION_GUID_GREENWICH_VILLAGE=
TOAST_REVENUE_CENTER_GUID_GREENWICH_VILLAGE=

# --- Union Square, 59 5th Ave
TOAST_RESTAURANT_GUID_UNION_SQUARE=
TOAST_CLIENT_ID_UNION_SQUARE=
TOAST_CLIENT_SECRET_UNION_SQUARE=
TOAST_DINING_OPTION_GUID_UNION_SQUARE=
TOAST_REVENUE_CENTER_GUID_UNION_SQUARE=

# --- Chelsea, 168 7th Ave
TOAST_RESTAURANT_GUID_CHELSEA=
TOAST_CLIENT_ID_CHELSEA=
TOAST_CLIENT_SECRET_CHELSEA=
TOAST_DINING_OPTION_GUID_CHELSEA=
TOAST_REVENUE_CENTER_GUID_CHELSEA=

# --- Murray Hill, 136 E 34th St
TOAST_RESTAURANT_GUID_MURRAY_HILL=
TOAST_CLIENT_ID_MURRAY_HILL=
TOAST_CLIENT_SECRET_MURRAY_HILL=
TOAST_DINING_OPTION_GUID_MURRAY_HILL=
TOAST_REVENUE_CENTER_GUID_MURRAY_HILL=

# --- Bryant Park, 1017 6th Ave
TOAST_RESTAURANT_GUID_BRYANT_PARK=
TOAST_CLIENT_ID_BRYANT_PARK=
TOAST_CLIENT_SECRET_BRYANT_PARK=
TOAST_DINING_OPTION_GUID_BRYANT_PARK=
TOAST_REVENUE_CENTER_GUID_BRYANT_PARK=

# --- Central Park, 1413 6th Ave
TOAST_RESTAURANT_GUID_CENTRAL_PARK=
TOAST_CLIENT_ID_CENTRAL_PARK=
TOAST_CLIENT_SECRET_CENTRAL_PARK=
TOAST_DINING_OPTION_GUID_CENTRAL_PARK=
TOAST_REVENUE_CENTER_GUID_CENTRAL_PARK=

# ---- Stripe ---------------------------------------------------------------
# sk_… is a SECRET — server only, never in the bundle, never in a response.
# pk_… is public by design and is served via GET /api/config/:locationId.
# whsec_… signs the webhook; set one per account, from that account's
#   Developers -> Webhooks page. Endpoint:
#   POST https://<your-api>/api/webhooks/stripe/<location-id>
# Subscribe each endpoint to:
#   payment_intent.amount_capturable_updated
#   payment_intent.succeeded
#   payment_intent.payment_failed
#   payment_intent.canceled
#   setup_intent.succeeded

STRIPE_SECRET_KEY_GREENWICH_VILLAGE=
STRIPE_PUBLISHABLE_KEY_GREENWICH_VILLAGE=
STRIPE_WEBHOOK_SECRET_GREENWICH_VILLAGE=

STRIPE_SECRET_KEY_UNION_SQUARE=
STRIPE_PUBLISHABLE_KEY_UNION_SQUARE=
STRIPE_WEBHOOK_SECRET_UNION_SQUARE=

STRIPE_SECRET_KEY_CHELSEA=
STRIPE_PUBLISHABLE_KEY_CHELSEA=
STRIPE_WEBHOOK_SECRET_CHELSEA=

STRIPE_SECRET_KEY_MURRAY_HILL=
STRIPE_PUBLISHABLE_KEY_MURRAY_HILL=
STRIPE_WEBHOOK_SECRET_MURRAY_HILL=

STRIPE_SECRET_KEY_BRYANT_PARK=
STRIPE_PUBLISHABLE_KEY_BRYANT_PARK=
STRIPE_WEBHOOK_SECRET_BRYANT_PARK=

STRIPE_SECRET_KEY_CENTRAL_PARK=
STRIPE_PUBLISHABLE_KEY_CENTRAL_PARK=
STRIPE_WEBHOOK_SECRET_CENTRAL_PARK=

#############################################################################
# CLIENT-SIDE (browser) — anything prefixed VITE_ IS PUBLIC.
# Never put a secret behind a VITE_ prefix. These are Toast restaurant GUIDs,
# which are identifiers rather than credentials, and are optional: the app only
# uses them for display and falls back cleanly when they are blank.
#############################################################################
# VITE_API_BASE=/api
# VITE_TOAST_GUID_GREENWICH_VILLAGE=
# VITE_TOAST_GUID_UNION_SQUARE=
# VITE_TOAST_GUID_CHELSEA=
# VITE_TOAST_GUID_MURRAY_HILL=
# VITE_TOAST_GUID_BRYANT_PARK=
# VITE_TOAST_GUID_CENTRAL_PARK=
