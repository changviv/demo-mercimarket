{
  "name": "merci-market-catering",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Merci Market NYC catering ordering \u2014 React front end with Toast POS and Stripe integration, one account per location.",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "lint": "eslint src server --ext .js,.jsx",
    "audit:tokens": "node scripts/audit-tokens.mjs",
    "audit:links": "node scripts/audit-links.mjs",
    "audit:parity": "node scripts/audit-parity.mjs",
    "audit:responsive": "node scripts/audit-responsive.mjs",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "audit": "npm run audit:tokens && npm run audit:secrets && npm run audit:links && npm run audit:parity && npm run audit:artifact && npm run audit:responsive",
    "audit:artifact": "node scripts/audit-artifact.mjs"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^3.1.1",
    "@stripe/stripe-js": "^5.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "vite": "^6.0.7"
  }
}
